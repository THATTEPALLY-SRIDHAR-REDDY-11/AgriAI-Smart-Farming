# ==========================================
# AgriAI Environment Configuration Example
# ==========================================

# 1. Spring Boot Backend Database Credentials (Neon PostgreSQL Cloud / Local)
DB_URL=jdbc:postgresql://ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=your_database_username_here
DB_PASSWORD=your_neon_password_here
JWT_SECRET=your_32_byte_jwt_secret_here
AI_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 2. FastAPI AI Service & RAG Credentials
GROQ_API_KEY=gsk_your_groq_api_key_here
CHROMA_API_KEY=ck_your_chroma_cloud_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=your_chroma_database_here
CHROMA_COLLECTION=your_chroma_collection_here

# 3. React Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8085/api
